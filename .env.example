# Copy to .env and fill in. Never commit the real .env.

# Database (docker-compose.yml creates this database and user on first start)
CMS_DB_NAME=cms
CMS_DB_USER=cms
CMS_DB_PASSWORD=change-me
# Only for an existing PostgreSQL: docker compose up -d --build --no-deps app
# CMS_DB_HOST=db.example.com
# Port of the database (bundled PostgreSQL is reachable from this host on 127.0.0.1 at this port)
# CMS_DB_PORT=5432

# Encrypts members' personal data. Pick a long random value once and BACK IT UP:
# if it is lost or changed, stored personal data can no longer be decrypted.
#   openssl rand -base64 32
CMS_CRYPTO_MASTER_KEY=

# Password of the first administrator account "admin" (used only when no admin exists yet)
CMS_ADMIN_PASSWORD=change-me-too

# Host port of the web site
CMS_PORT=8080

# Largest single upload (videos, music), e.g. 500MB, 2GB
# CMS_MAX_UPLOAD_SIZE=1GB
